@{
    ViewData["Title"] = "Acceso al Sistema";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CEDIS</title>
    
    <!-- Vinculamos tu nuevo CSS -->
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>

    <div class="login-box">
        <h2 class="login-title">CEDIS Compensaciones</h2>
        <p class="login-subtitle">Inicia sesión con tu cuenta de Google para identificarte en el sistema.</p>
        
        @if (TempData["MensajeError"] != null)
        {
            <div class="error-message">
                @TempData["MensajeError"]
            </div>
        }

        <!-- ÚNICA ACCIÓN: Iniciar sesión -->
        <a href="/Home/LoginConGoogle" class="btn-google">
            🌐 Iniciar con Google
        </a>
    </div>

</body>
</html>