@{ ViewData["Title"] = "Desbloquear Área"; }

<div style="max-width: 400px; margin: 50px auto; background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
    <h3 style="color: #d93025; text-align: center;">🛡️ Espacio de Trabajo Restringido</h3>
    <p style="color: #5f6368; text-align: center; font-size: 14px;">Ingresa la contraseña operativa del departamento para habilitar la captura de pólizas.</p>

    <form action="/Workspace/ValidarWorkspace" method="post" style="margin-top: 20px;">
        <input type="hidden" name="idDepartamento" value="@ViewBag.ID_Depto" />
        <input type="password" name="contrasena" placeholder="Contraseña del Área" required style="width: 100%; padding: 10px; margin-bottom: 15px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" />
        <button type="submit" style="width: 100%; padding: 10px; background-color: #d93025; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">Desbloquear Edición</button>
    </form>
    
    <p style="color: red; text-align: center; margin-top: 15px;">@TempData["ErrorWorkspace"]</p>
</div>