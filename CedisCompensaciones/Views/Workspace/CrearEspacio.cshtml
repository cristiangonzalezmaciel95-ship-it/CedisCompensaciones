@{
    ViewData["Title"] = "Crear Nuevo Espacio";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CEDIS</title>
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>

    <div class="login-box">
        <h2 class="login-title">👑 Nuevo Espacio de Trabajo</h2>
        <p class="login-subtitle">Define el nombre del área y establece la contraseña maestra. Automáticamente serás el Super Administrador.</p>
        
        <form action="/Workspace/GuardarNuevoEspacio" method="post" class="form-crear">
            
            <label class="form-label">Nombre del Departamento o Área</label>
            <input type="text" name="nombreDepartamento" placeholder="Ej: CEDIS Norte, Finanzas, Auditoría..." required class="form-input" />
            
            <label class="form-label">Contraseña Maestra del Espacio</label>
            <input type="password" name="contrasenaArea" placeholder="Crea una contraseña segura" required class="form-input" />
            
            <button type="submit" class="btn-google btn-dark">
                Crear y Asignarme como Admin
            </button>
        </form>

        <div class="cancel-container">
            <a href="/Workspace/Hub" class="cancel-link">← Cancelar y volver al Hub</a>
        </div>
    </div>

</body>
</html>